# dependencies
node_modules/

# secrets — every key this project uses lives in Vercel env vars, never here.
# ANTHROPIC_API_KEY, GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, GOOGLE_CLIENT_SECRET.
.env
.env.*
!.env.example

# Google hands you the OAuth client secret as a download and no longer lets
# you view it again, which makes it exactly the sort of file that ends up
# sitting in a project folder. This repo is public.
client_secret*.json
*credentials*.json

# vercel
.vercel/

# macOS
.DS_Store

# Claude Code. launch.json describes how to preview this repo and is worth
# keeping; settings.local.json is one machine's permission grants and is not.
.claude/settings.local.json

# Xcode. The project file and the shared scheme are the build; xcuserdata is
# one person's window layout and breakpoints, and DerivedData is output.
ios/**/xcuserdata/
ios/build/
DerivedData/
*.xcuserstate

# Signing is per-machine — see ios/Signing.xcconfig.
ios/Local.xcconfig

# Carousel renders and seeded canvases are output, not source.
docs/carousel/out/

# Reference captures and design exports — input to the redesign, not
# source, and 116MB of PNGs in a public repo. They stay on disk here.
loudsrl_website_screenshots/
my.adhd_screenshot/
myadhd-ui-design/
myadhd-ui-design.zip
